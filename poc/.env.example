# Application de test (PoC). Aucune valeur versionnee : copier vers .env.local (ignore par Git).
# Voir docs/03-architecture/poc-specification.md section 4.

# --- PWA (lues par Vite a la construction) ---
# ID client OAuth Web (obligatoire : l'application refuse de demarrer s'il est vide)
VITE_GOOGLE_WEB_CLIENT_ID=
# "/" (Cloudflare) ou "/<nom-du-depot>/" (GitHub Pages)
VITE_BASE_PATH=
# Origine hebergee, affichee dans le Diagnostic
VITE_APP_ORIGIN=
# Valeur de appProperties.app (defaut : objectifs-taches-poc)
VITE_POC_APP_PROPERTY=
# Nom du dossier Drive (defaut : Done Juan (POC))
VITE_POC_FOLDER_NAME=

# --- Android (lues par scripts/prepare-android.sh et Gradle) ---
# Nom de paquet du PoC : fr.donejuan.poc
POC_ANDROID_PACKAGE=
POC_VERSION_CODE=
POC_VERSION_NAME=
# debug ou release (deux cles distinctes, P9)
POC_BUILD_TYPE=
# Chemin du fichier de cle, HORS depot
POC_KEYSTORE_FILE=
# Secrets de signature : jamais versionnes
POC_KEYSTORE_PASSWORD=
POC_KEY_ALIAS=
POC_KEY_PASSWORD=
