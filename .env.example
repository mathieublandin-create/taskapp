# Variables de construction publiques (conventions.md §9.1). Valeurs fictives : les vraies valeurs vont dans
# `.env.local` (non versionné), transmises hors dépôt. Toute variable VITE_ est publique.
VITE_ENV=dev
VITE_BASE_PATH=/
VITE_APP_ORIGIN=http://localhost:5173
VITE_GOOGLE_WEB_CLIENT_ID=identifiant-client-fictif.apps.googleusercontent.com
